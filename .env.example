ADLENS_DB_USER=analytics
ADLENS_DB_PASSWORD=
# Local model via Ollama (default used for the results)
ADLENS_LLM_BASE_URL=http://localhost:11434/v1
ADLENS_MODEL=qwen2.5-3b-16k
ADLENS_MAX_STEPS=2
